  "source": "..\\..\\..\\Procedurier",
  "version": "package.json",
  "include": [
    "package.json",
    "README.md",
    "src",
    "assets",
    "docs",
    "mcp",
    "node_modules\\koffi",
    "node_modules\\@koromix\\koffi-win32-x64",
    "node_modules\\electron\\dist"
  ],
  "exclude": ["node_modules\\electron\\dist\\locales\\*.pak"],
  "keep": ["node_modules\\electron\\dist\\locales\\fr.pak", "node_modules\\electron\\dist\\locales\\en-US.pak"],
  "app": {
    "exe": "node_modules\\electron\\dist\\electron.exe",
    "args": ["."],
    "icon": "assets\\icon.png",
    "protocol": true,
    "autostart": false
  }
