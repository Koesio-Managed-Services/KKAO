<UserControl x:Class="KKAO.Ui.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:KKAO.Ui">
    <UserControl.Resources>
        <!-- Mini fenetre dessinee pour les tuiles de theme -->
        <DataTemplate x:Key="ThemePreview">
            <Border Width="190" Height="112" CornerRadius="9" Background="{Binding [0]}" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding [1]}" CornerRadius="9,0,0,9">
                        <StackPanel Margin="8,10">
                            <Border Width="16" Height="16" CornerRadius="4" Background="#6E398E" HorizontalAlignment="Left" />
                            <Border Height="5" CornerRadius="2" Background="{Binding [2]}" Margin="0,12,4,0" Opacity="0.6" />
                            <Border Height="5" CornerRadius="2" Background="#6E398E" Margin="0,6,8,0" />
                            <Border Height="5" CornerRadius="2" Background="{Binding [2]}" Margin="0,6,2,0" Opacity="0.6" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10">
                        <Border Height="30" CornerRadius="5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6E398E" Offset="0" />
                                    <GradientStop Color="#E94B57" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <Border Height="40" CornerRadius="5" Background="{Binding [3]}" Margin="0,0,4,0" />
                            <Border Height="40" CornerRadius="5" Background="{Binding [3]}" Margin="4,0,0,0" />
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="36,30,36,36" MaxWidth="940">
            <TextBlock Text="Réglages" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,22">
                <Run Text="Tout ce qui concerne " /><Run Text="{x:Static ui:Brand.Name}" /><Run Text=" lui-même. Chaque appli a aussi ses réglages, dans sa page." />
            </TextBlock>

            <!-- Apparence -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Apparence" Style="{StaticResource H3}" />
                    <TextBlock Text="Changez quand vous voulez : tout s'adapte à l'instant." Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,16" />
                    <WrapPanel>
                        <RadioButton Style="{StaticResource ThemeTile}" GroupName="theme" ui:Btn.Badge="Sombre"
                                     IsChecked="{Binding Theme, Converter={StaticResource EqualsToBool}, ConverterParameter=dark}">
                            <ContentPresenter ContentTemplate="{StaticResource ThemePreview}">
                                <ContentPresenter.Content>
                                    <x:Array Type="Brush">
                                        <SolidColorBrush Color="#232323" />
                                        <SolidColorBrush Color="#1B1B1B" />
                                        <SolidColorBrush Color="#B0AEA5" />
                                        <SolidColorBrush Color="#2D2D2D" />
                                    </x:Array>
                                </ContentPresenter.Content>
                            </ContentPresenter>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ThemeTile}" GroupName="theme" ui:Btn.Badge="Clair"
                                     IsChecked="{Binding Theme, Converter={StaticResource EqualsToBool}, ConverterParameter=light}">
                            <ContentPresenter ContentTemplate="{StaticResource ThemePreview}">
                                <ContentPresenter.Content>
                                    <x:Array Type="Brush">
                                        <SolidColorBrush Color="#FAF9F5" />
                                        <SolidColorBrush Color="#F1EFE8" />
                                        <SolidColorBrush Color="#6B6962" />
                                        <SolidColorBrush Color="#FFFFFF" />
                                    </x:Array>
                                </ContentPresenter.Content>
                            </ContentPresenter>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ThemeTile}" GroupName="theme" ui:Btn.Badge="Comme Windows"
                                     IsChecked="{Binding Theme, Converter={StaticResource EqualsToBool}, ConverterParameter=system}">
                            <Grid Width="190" Height="112">
                                <ContentPresenter ContentTemplate="{StaticResource ThemePreview}">
                                    <ContentPresenter.Content>
                                        <x:Array Type="Brush">
                                            <SolidColorBrush Color="#232323" />
                                            <SolidColorBrush Color="#1B1B1B" />
                                            <SolidColorBrush Color="#B0AEA5" />
                                            <SolidColorBrush Color="#2D2D2D" />
                                        </x:Array>
                                    </ContentPresenter.Content>
                                </ContentPresenter>
                                <ContentPresenter ContentTemplate="{StaticResource ThemePreview}">
                                    <ContentPresenter.Clip>
                                        <PathGeometry Figures="M 95,0 L 190,0 L 190,112 L 95,112 Z" />
                                    </ContentPresenter.Clip>
                                    <ContentPresenter.Content>
                                        <x:Array Type="Brush">
                                            <SolidColorBrush Color="#FAF9F5" />
                                            <SolidColorBrush Color="#F1EFE8" />
                                            <SolidColorBrush Color="#6B6962" />
                                            <SolidColorBrush Color="#FFFFFF" />
                                        </x:Array>
                                    </ContentPresenter.Content>
                                </ContentPresenter>
                            </Grid>
                        </RadioButton>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Icones -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Icônes près de l'horloge" Style="{StaticResource H3}" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,14">
                        <Run Text="Une seule icône pour tout, ou une icône par appli en marche en plus de celle de " /><Run Text="{x:Static ui:Brand.Name}" /><Run Text=". Chaque appli peut faire exception dans sa page." />
                    </TextBlock>
                    <WrapPanel>
                        <RadioButton Style="{StaticResource Segment}" GroupName="iconMode" IsChecked="{Binding IconMode, Converter={StaticResource EqualsToBool}, ConverterParameter=launcher}">
                            <TextBlock><Run Text="Une seule icône (" /><Run Text="{x:Static ui:Brand.Name}" /><Run Text=")" /></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Segment}" GroupName="iconMode" Content="Une icône par appli" IsChecked="{Binding IconMode, Converter={StaticResource EqualsToBool}, ConverterParameter=all}" />
                    </WrapPanel>
                    <CheckBox Style="{StaticResource Switch}" Margin="0,16,0,0" IsChecked="{Binding ShowToolSubmenus}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"><Run Text="Menu complet des applis dans l'icône " /><Run Text="{x:Static ui:Brand.Name}" /></TextBlock>
                            <TextBlock Text="Sinon, le clic droit ne montre que vos actions rapides." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Demarrage -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Démarrage" Style="{StaticResource H3}" />
                    <CheckBox Style="{StaticResource Switch}" Margin="0,16,0,0" IsChecked="{Binding StartWithWindows}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"><Run Text="Lancer " /><Run Text="{x:Static ui:Brand.Name}" /><Run Text=" avec Windows" /></TextBlock>
                            <TextBlock Text="Discrètement : seule l'icône apparaît, avec les applis qui démarrent avec lui." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" Margin="0,16,0,0" IsChecked="{Binding OpenAtStartup}">
                        <StackPanel>
                            <TextBlock Text="Ouvrir cette fenêtre à l'ouverture de session" FontWeight="SemiBold" />
                            <TextBlock Text="Pratique pour garder un œil sur vos applis." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Installation -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Installation" Style="{StaticResource H3}" />
                        <TextBlock Text="{Binding InstallStatusText}" Style="{StaticResource Muted}" Margin="0,6,16,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Style="{StaticResource BtnPrimary}" ui:Btn.Glyph="&#xE896;" Command="{Binding InstallKkaoCommand}"
                                Visibility="{Binding CanInstallKkao, Converter={StaticResource BoolToVis}}">
                            <TextBlock><Run Text="Installer " /><Run Text="{x:Static ui:Brand.Name}" /></TextBlock>
                        </Button>
                        <Button Style="{StaticResource BtnDanger}" ui:Btn.Glyph="&#xE74D;" Command="{Binding UninstallKkaoCommand}"
                                Visibility="{Binding CanUninstallKkao, Converter={StaticResource BoolToVis}}">
                            <TextBlock><Run Text="Désinstaller " /><Run Text="{x:Static ui:Brand.Name}" /></TextBlock>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Mises a jour -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Mises à jour" Style="{StaticResource H3}" />
                        <TextBlock Text="{Binding UpdatesText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,16,0" />
                        <CheckBox Style="{StaticResource Switch}" Margin="0,14,16,0" IsChecked="{Binding AutoUpdate}">
                            <StackPanel>
                                <TextBlock Text="Installer les mises à jour automatiquement" FontWeight="SemiBold" />
                                <TextBlock Text="Téléchargées en arrière-plan, installées quand vous n'utilisez pas l'appli. Rien n'est fermé pendant votre travail, et l'ancienne version revient si la nouvelle ne démarre pas." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <StackPanel Margin="0,10,16,0" Visibility="{Binding KkaoUpdating, Converter={StaticResource BoolToVis}}">
                            <ProgressBar Value="{Binding KkaoUpdateProgress, Mode=OneWay}" />
                            <TextBlock Text="{Binding KkaoUpdatePhase}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Style="{StaticResource BtnPrimary}" ui:Btn.Glyph="&#xE896;" Content="{Binding KkaoUpdateButtonText}" Command="{Binding UpdateKkaoCommand}"
                                Visibility="{Binding HasKkaoUpdate, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8" />
                        <Button Style="{StaticResource Btn}" ui:Btn.Glyph="&#xE72C;" Content="Rechercher" Command="{Binding CheckUpdatesCommand}"
                                IsEnabled="{Binding CanCheckUpdates}" Visibility="{Binding RemoteEnabled, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Guide -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Guide et missions" Style="{StaticResource H3}" />
                    <WrapPanel Margin="0,14,0,0">
                        <Button Style="{StaticResource Btn}" Content="Rejouer le guide de démarrage" ui:Btn.Glyph="&#xE768;" Command="{Binding ReplayGuideCommand}" Margin="0,0,10,10" />
                        <Button Style="{StaticResource Btn}" Content="Visite guidée" ui:Btn.Glyph="&#xE897;" Command="{Binding StartTourCommand}" Margin="0,0,10,10" />
                        <Button Style="{StaticResource BtnGhost}" Content="Remettre à zéro les Premiers pas" ui:Btn.Glyph="&#xE72C;" Command="{Binding ResetQuestsCommand}" Margin="0,0,10,10" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Depannage -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Dépannage" Style="{StaticResource H3}" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,14" Text="Pour l'équipe qui vous aide : le journal dit ce qui s'est passé, sans jamais le contenu de vos notes." />
                    <WrapPanel>
                        <Button Style="{StaticResource Btn}" Content="Ouvrir le journal" ui:Btn.Glyph="&#xE8A5;" Command="{Binding OpenLogCommand}" Margin="0,0,10,10" />
                        <Button Style="{StaticResource Btn}" Content="Dossier des applis" ui:Btn.Glyph="&#xE8B7;" Command="{Binding OpenAppsFolderCommand}" Margin="0,0,10,10" />
                        <Button Style="{StaticResource Btn}" Content="Dossier des réglages" ui:Btn.Glyph="&#xE8B7;" Command="{Binding OpenDataFolderCommand}" Margin="0,0,10,10" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- A propos -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding LogoImage}" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource H3}" />
                        <TextBlock Text="{Binding BrandLong}" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Tagline}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="14,8" VerticalAlignment="Center">
                        <Image Source="{Binding KoesioLogo}" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
