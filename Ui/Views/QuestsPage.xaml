<UserControl x:Class="KKAO.Ui.QuestsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:KKAO.Ui">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="36,30,36,36" MaxWidth="1000">
            <TextBlock Text="Premiers pas" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,22">
                <Run Text="Six petites missions pour devenir un pro de " /><Run Text="{x:Static ui:Brand.Name}" /><Run Text=". Chacune débloque un succès." />
            </TextBlock>

            <!-- Niveau -->
            <Border CornerRadius="20" Background="{DynamicResource HeroBrush}" Padding="28,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="92" Height="92">
                        <Ellipse Fill="#26FFFFFF" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding QuestsDone}" FontFamily="{DynamicResource TitleFont}" FontSize="34" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                            <TextBlock Foreground="#DDFFFFFF" FontSize="12" HorizontalAlignment="Center"><Run Text="sur " /><Run Text="{Binding QuestsTotal, Mode=OneWay}" /></TextBlock>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                        <TextBlock Foreground="#DDFFFFFF" FontSize="13" Text="Votre niveau" />
                        <TextBlock Text="{Binding QuestLevel}" FontFamily="{DynamicResource TitleFont}" FontSize="28" FontWeight="Bold" Foreground="White" />
                        <Border Height="8" CornerRadius="4" Background="#33FFFFFF" Margin="0,12,0,0" MaxWidth="460" HorizontalAlignment="Stretch">
                            <ProgressBar Value="{Binding QuestProgress, Mode=OneWay}" Height="8">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Grid>
                                            <Border x:Name="PART_Track" CornerRadius="4" Background="Transparent" />
                                            <Border x:Name="PART_Indicator" CornerRadius="4" Background="White" HorizontalAlignment="Left" />
                                        </Grid>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Missions -->
            <TextBlock Text="Missions" Style="{StaticResource H2}" Margin="2,28,0,14" />
            <ItemsControl ItemsSource="{Binding QuestList}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Disc" Width="46" Height="46" CornerRadius="23" Background="{DynamicResource SurfaceAlt}">
                                    <TextBlock x:Name="DiscGlyph" Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="18" Foreground="{DynamicResource TextMuted}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border x:Name="DonePill" Grid.Column="2" CornerRadius="12" Padding="12,5" Background="{DynamicResource BlueSoft}" VerticalAlignment="Center" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource BlueFg}" Margin="0,0,6,0" />
                                        <TextBlock Text="Accomplie" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BlueFg}" />
                                    </StackPanel>
                                </Border>
                                <Button x:Name="Go" Grid.Column="2" Style="{StaticResource Btn}" Content="Y aller" ui:Btn.Glyph="&#xE76C;" Command="{Binding GoCommand}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Done}" Value="True">
                                <Setter TargetName="Disc" Property="Background" Value="{DynamicResource HeroBrush}" />
                                <Setter TargetName="DiscGlyph" Property="Foreground" Value="White" />
                                <Setter TargetName="DonePill" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Go" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Succes -->
            <TextBlock Text="Succès" Style="{StaticResource H2}" Margin="2,20,0,14" />
            <ItemsControl ItemsSource="{Binding QuestList}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Badge" CornerRadius="16" Padding="16" Margin="0,0,12,12" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <StackPanel>
                                <Grid Width="56" Height="56" HorizontalAlignment="Left">
                                    <Ellipse x:Name="Medal" Fill="{DynamicResource SurfaceAlt}" />
                                    <TextBlock x:Name="MedalGlyph" Text="&#xE72E;" Style="{StaticResource Glyph}" FontSize="20" Foreground="{DynamicResource TextFaint}" />
                                </Grid>
                                <TextBlock x:Name="Name" Text="{Binding Achievement}" FontWeight="Bold" Margin="0,12,0,2" TextWrapping="Wrap" Foreground="{DynamicResource TextFaint}" />
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Done}" Value="True">
                                <Setter TargetName="Medal" Property="Fill" Value="{DynamicResource HeroBrush}" />
                                <Setter TargetName="MedalGlyph" Property="Text" Value="&#xE735;" />
                                <Setter TargetName="MedalGlyph" Property="Foreground" Value="White" />
                                <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource Text}" />
                                <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
