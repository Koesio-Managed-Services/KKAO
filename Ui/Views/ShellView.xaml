<UserControl x:Class="KKAO.Ui.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:KKAO.Ui"
             FontFamily="{DynamicResource BodyFont}" FontSize="14"
             Foreground="{DynamicResource Text}" Background="{DynamicResource Bg}"
             TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Navigation ===== -->
        <Border Background="{DynamicResource BgNav}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,22,16,16" LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,26">
                    <Image Source="{Binding LogoImage}" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BrandName}" FontFamily="{DynamicResource TitleFont}" FontWeight="Bold" FontSize="21" />
                        <TextBlock Text="{Binding BrandLong}" Style="{StaticResource Caption}" TextWrapping="NoWrap" />
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        CornerRadius="12" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource HeroBrush}">
                            <TextBlock Text="{Binding UserInitials}" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserDisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="NoWrap">
                                <Run Text="{Binding VersionText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding QuestLevel, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel>
                    <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" ui:Btn.Glyph="&#xE80F;" Content="Accueil"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EqualsToBool}, ConverterParameter=home}" />
                    <RadioButton x:Name="NavApps" Style="{StaticResource NavItem}" ui:Btn.Glyph="&#xE71D;" Content="Applications"
                                 ui:Btn.Badge="{Binding AppsBadge}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EqualsToBool}, ConverterParameter=apps}" />
                    <RadioButton x:Name="NavQuick" Style="{StaticResource NavItem}" ui:Btn.Glyph="&#xE945;" Content="Actions rapides"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EqualsToBool}, ConverterParameter=quick}" />
                    <RadioButton x:Name="NavQuests" Style="{StaticResource NavItem}" ui:Btn.Glyph="&#xE734;" Content="Premiers pas"
                                 ui:Btn.Badge="{Binding QuestsText}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EqualsToBool}, ConverterParameter=quests}" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" ui:Btn.Glyph="&#xE713;" Content="Réglages"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EqualsToBool}, ConverterParameter=settings}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Page ===== -->
        <ContentControl x:Name="PageHost" Grid.Column="1" Focusable="False" />

        <!-- ===== Notification dans la fenetre (succes, installation…) ===== -->
        <Border x:Name="Toast" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28" Width="360"
                Style="{StaticResource Card}" Padding="16" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastShift" />
            </Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="ToastBadge" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource HeroBrush}" VerticalAlignment="Top">
                    <TextBlock x:Name="ToastGlyph" Style="{StaticResource Glyph}" Foreground="White" FontSize="18" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,8,0">
                    <TextBlock x:Name="ToastTitle" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" />
                    <TextBlock x:Name="ToastText" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource BtnIcon}" Content="&#xE711;" Width="26" Height="26" VerticalAlignment="Top" Click="CloseToast" />
            </Grid>
        </Border>

        <!-- ===== Visite guidee ===== -->
        <Canvas x:Name="CoachLayer" Grid.ColumnSpan="2" Visibility="Collapsed" Background="Transparent" />

        <!-- ===== Guide de demarrage ===== -->
        <ContentControl x:Name="OnboardingHost" Grid.ColumnSpan="2" Focusable="False" />

        <!-- ===== Confettis ===== -->
        <Canvas x:Name="ConfettiLayer" Grid.ColumnSpan="2" IsHitTestVisible="False" ClipToBounds="True" />
    </Grid>
</UserControl>
