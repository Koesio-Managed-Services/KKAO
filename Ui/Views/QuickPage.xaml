<UserControl x:Class="KKAO.Ui.QuickPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:KKAO.Ui">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="36,30,36,36" MaxWidth="1120">
            <TextBlock Text="Actions rapides" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,22" MaxWidth="760" HorizontalAlignment="Left">
                <Run Text="Le menu du clic droit sur l'icône " /><Run Text="{x:Static ui:Brand.Name}" /><Run Text=" : vos actions préférées de toutes les applis, au même endroit. Renommez-les, réordonnez-les. Les raccourcis clavier se règlent dans chaque appli." />
            </TextBlock>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!-- Editeur -->
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="14,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Muted}" Margin="8,10" Visibility="{Binding QuickEntries.Count, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}"
                                       Text="Votre menu rapide est vide. Ajoutez des actions depuis la colonne de droite." />
                            <ItemsControl ItemsSource="{Binding QuickEntries}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE76F;" Style="{StaticResource Glyph}" Foreground="{DynamicResource TextFaint}" Margin="6,0,10,0" />
                                            <!-- Separateur -->
                                            <Grid Grid.Column="1" Visibility="{Binding IsSeparator, Converter={StaticResource BoolToVis}}" Height="34">
                                                <Rectangle Height="1" Fill="{DynamicResource BorderStrong}" VerticalAlignment="Center" />
                                                <Border Background="{DynamicResource Surface}" HorizontalAlignment="Center" Padding="10,0">
                                                    <TextBlock Text="séparateur" Style="{StaticResource Caption}" />
                                                </Border>
                                            </Grid>
                                            <!-- Action -->
                                            <Grid Grid.Column="1" Visibility="{Binding IsSeparator, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding AppIcon}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="{Binding AppName}" />
                                                <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                                    <TextBox Text="{Binding Label, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" ToolTip="Libellé (vide : celui de l'appli)" />
                                                    <TextBlock Style="{StaticResource Caption}" Margin="2,3,0,0">
                                                        <Run Text="{Binding AppName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DefaultLabel, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="Cette action n'existe plus dans l'appli." Foreground="{DynamicResource CoralFg}" FontSize="12" Margin="2,2,0,0"
                                                               Visibility="{Binding Unavailable, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{StaticResource Kbd}" Visibility="{Binding Shortcut, Converter={StaticResource HasValueToVis}}" Margin="0,0,6,16">
                                                    <TextBlock Text="{Binding Shortcut}" FontSize="11" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource TextMuted}" />
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="4,1,0,0">
                                                <Button Style="{StaticResource BtnIcon}" Content="&#xE70E;" ToolTip="Monter" Command="{Binding MoveUpCommand}" />
                                                <Button Style="{StaticResource BtnIcon}" Content="&#xE70D;" ToolTip="Descendre" Command="{Binding MoveDownCommand}" />
                                                <Button Style="{StaticResource BtnIcon}" Content="&#xE711;" ToolTip="Retirer" Command="{Binding RemoveCommand}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource Btn}" Content="Ajouter un séparateur" ui:Btn.Glyph="&#xE710;" Command="{Binding AddSeparatorCommand}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource BtnGhost}" Content="Revenir au menu par défaut" ui:Btn.Glyph="&#xE72C;" Command="{Binding ResetQuickCommand}" />
                    </StackPanel>
                </StackPanel>

                <!-- Apercu + catalogue -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Aperçu du menu" Style="{StaticResource H3}" Margin="2,0,0,10" />
                    <Border Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="10" Padding="6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25" />
                        </Border.Effect>
                        <StackPanel>
                            <Grid Margin="10,7">
                                <TextBlock FontWeight="Bold"><Run Text="Ouvrir " /><Run Text="{x:Static ui:Brand.Name}" /></TextBlock>
                            </Grid>
                            <Rectangle Height="1" Fill="{DynamicResource Border}" Margin="6,3" />
                            <ItemsControl ItemsSource="{Binding QuickEntries}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Visibility="{Binding InPreview, Converter={StaticResource BoolToVis}}">
                                            <Rectangle Height="1" Fill="{DynamicResource Border}" Margin="6,4" Visibility="{Binding IsSeparator, Converter={StaticResource BoolToVis}}" />
                                            <Grid Margin="10,6" Visibility="{Binding IsSeparator, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding AppIcon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayLabel}" Margin="10,0,12,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding Shortcut}" Foreground="{DynamicResource TextFaint}" FontSize="12" VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Rectangle Height="1" Fill="{DynamicResource Border}" Margin="6,3" />
                            <TextBlock Text="Réglages…" Margin="10,7" />
                            <TextBlock Margin="10,7"><Run Text="Quitter " /><Run Text="{x:Static ui:Brand.Name}" /></TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Ajouter une action" Style="{StaticResource H3}" Margin="2,26,0,10" />
                    <TextBlock Style="{StaticResource Muted}" Visibility="{Binding QuickCatalog.Count, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}"
                               Text="Installez une appli pour découvrir ses actions." />
                    <ItemsControl ItemsSource="{Binding QuickCatalog}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Image Source="{Binding AppIcon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" Visibility="{Binding Hint, Converter={StaticResource HasValueToVis}}" Margin="0,2,0,0" />
                                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Label}" />
                                                            <TextBlock Text="{Binding Shortcut}" Foreground="{DynamicResource TextFaint}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Content="&#xE710;" ToolTip="Ajouter au menu" Command="{Binding AddCommand}"
                                                                IsEnabled="{Binding AlreadyIn, Converter={StaticResource InverseBool}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
