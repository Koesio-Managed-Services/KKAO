<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Theme sombre, derive du gris fonce Koesio #3C3C3C et du clair #FAF9F5 -->
    <sys:Boolean x:Key="IsDark">True</sys:Boolean>
    <SolidColorBrush x:Key="Bg" Color="#232323" />
    <SolidColorBrush x:Key="BgNav" Color="#1B1B1B" />
    <SolidColorBrush x:Key="Surface" Color="#2D2D2D" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#343434" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#3C3C3C" />
    <SolidColorBrush x:Key="Border" Color="#3C3C3C" />
    <SolidColorBrush x:Key="BorderStrong" Color="#4C4C4C" />
    <SolidColorBrush x:Key="Text" Color="#FAF9F5" />
    <SolidColorBrush x:Key="TextMuted" Color="#B0AEA5" />
    <SolidColorBrush x:Key="TextFaint" Color="#86837B" />
    <SolidColorBrush x:Key="Accent" Color="#6E398E" />
    <SolidColorBrush x:Key="AccentHover" Color="#8049A3" />
    <SolidColorBrush x:Key="AccentFg" Color="#C9A3E6" />
    <SolidColorBrush x:Key="AccentSoft" Color="#406E398E" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Coral" Color="#E94B57" />
    <SolidColorBrush x:Key="CoralFg" Color="#FF8A93" />
    <SolidColorBrush x:Key="CoralSoft" Color="#33E94B57" />
    <SolidColorBrush x:Key="Blue" Color="#41C0F0" />
    <SolidColorBrush x:Key="BlueFg" Color="#7FD6F7" />
    <SolidColorBrush x:Key="BlueSoft" Color="#2941C0F0" />
    <SolidColorBrush x:Key="Overlay" Color="#C0101010" />
    <SolidColorBrush x:Key="InputBg" Color="#1F1F1F" />
    <SolidColorBrush x:Key="KbdBg" Color="#262626" />
    <SolidColorBrush x:Key="MenuBg" Color="#2B2B2B" />
    <SolidColorBrush x:Key="Shadow" Color="#000000" />
</ResourceDictionary>
